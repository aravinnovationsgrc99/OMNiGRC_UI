# =========================================================================
# OMNIGRC BLOG & ADMIN — SUPABASE ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to .env.local in the root directory: e:\Arav Innovations\omnigrc_website\OMNiGRC_UI\.env.local

# 1. Supabase Web API Keys (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server-Side Secret Key (From Supabase Dashboard -> Project Settings -> API -> service_role)
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ (Server-Only Secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Admin Subdomain URL (Optional configuration for admin subdomain routing)
NEXT_PUBLIC_ADMIN_URL=https://admin.omnigrc.com

# =========================================================================
# DIRECT POSTGRESQL DATABASE URLS (OPTIONAL / PRISMA ONLY)
# Note: Not required for standard Supabase SDK API access, but documented below
# for direct PostgreSQL connections or Prisma migrations if used later.
# =========================================================================
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
